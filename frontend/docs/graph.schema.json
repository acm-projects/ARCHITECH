{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/acm-projects/ARCHITECH/frontend/docs/graph.schema.json",
  "title": "ARCHITECH architecture graph",
  "description": "One saved architecture: React Flow nodes and edges. See graph-spec.md. Covers rules 1-4 of the spec's validation section; rules 5-9 (unique ids, edges between existing nodes, per-type property ranges, implementation belongs to type) need code.",
  "type": "object",
  "required": ["schemaVersion", "nodes", "edges"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } }
  },
  "$defs": {
    "componentTypeId": {
      "description": "Same values as ArchitectureNodeType (src/lib/architecture/types.ts) and component_types.id.",
      "enum": [
        "client", "web-app", "mobile-app", "cdn", "dns", "server", "api-gateway",
        "load-balancer", "database", "cache", "queue", "worker", "object-storage",
        "search", "auth"
      ]
    },
    "node": {
      "type": "object",
      "required": ["id", "type", "position", "data"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "const": "architecture" },
        "position": {
          "type": "object",
          "required": ["x", "y"],
          "additionalProperties": false,
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" }
          }
        },
        "data": { "$ref": "#/$defs/nodeData" }
      }
    },
    "nodeData": {
      "type": "object",
      "required": ["type", "label"],
      "additionalProperties": false,
      "properties": {
        "type": { "$ref": "#/$defs/componentTypeId" },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "pattern": "\\S",
          "description": "1-60 characters, not only whitespace."
        },
        "implementation": {
          "type": "string",
          "minLength": 1,
          "description": "component_implementations.id belonging to data.type. Omitted: the type's default."
        },
        "properties": { "$ref": "#/$defs/nodeProperties" }
      }
    },
    "nodeProperties": {
      "description": "Flat user overrides. Generic storage rules for every key, plus the meaning of the keys the metrics engine reads. Per-type ranges are checked in code (componentProperties.ts).",
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_-]*$", "maxLength": 40 },
      "additionalProperties": {
        "oneOf": [
          { "type": "string", "maxLength": 200 },
          { "type": "number" },
          { "type": "boolean" }
        ]
      },
      "properties": {
        "replicas": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "capacity": { "type": "number", "minimum": 1, "maximum": 10000000 },
        "cacheHitRate": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "edge": {
      "type": "object",
      "required": ["id", "source", "target"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "sourceHandle": { "type": "string" },
        "targetHandle": { "type": "string" }
      }
    }
  }
}
