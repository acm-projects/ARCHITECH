generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//This is the schema for the account, contains fields required by GitHub and Google
model Account {
  id                 String  @id @default(cuid())
  userId             String  @map("user_id")
  type               String
  provider           String
  providerAccountId  String  @map("provider_account_id")
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?
  refresh_token_expires_in Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}
//Keeps session open for users until they sign out or close the program
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}
//User information fields for database
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  passwordHash  String?   
  experienceLevel String? 
  accounts      Account[]
  sessions      Session[]

  @@map("users")
}
//
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
// ---- Component library ----
// The components a user can place on the canvas (types) and the technologies behind each one
// (implementations). Filled by prisma/seed.ts; see docs/graph-spec.md for how a saved graph
// refers to these rows.

// Semantic group of a component type. Same values as ComponentFamily in
// src/components/workspace/componentCatalog.ts.
enum ComponentFamily {
  general
  frontend
  backend
  data
  infrastructure

  @@map("component_family")
}

// A kind of component, e.g. "database". `id` is the same key the canvas stores in
// node.data.type (ArchitectureNodeType in src/lib/architecture/types.ts).
model ComponentType {
  id              String                    @id
  label           String
  family          ComponentFamily
  description     String
  sortOrder       Int                       @map("sort_order")
  implementations ComponentImplementation[]
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")

  @@map("component_types")
}

// A concrete technology for a component type, e.g. PostgreSQL for "database". Exactly one
// implementation per type is the default (enforced by the seed script). The numbers are the
// per-instance baseline the metrics engine uses, with the same meaning as SimulationProfile in
// src/lib/architecture/evaluation/capabilities.ts: educational estimates, not benchmarks.
model ComponentImplementation {
  id                     String        @id
  componentTypeId        String        @map("component_type_id")
  name                   String
  vendor                 String?
  description            String
  isDefault              Boolean       @default(false) @map("is_default")
  sortOrder              Int           @map("sort_order")
  // Work one instance can do per second. Null: never limits throughput (clients, frontends).
  capacityPerInstance    Int?          @map("capacity_per_instance")
  // Concurrent connections one instance can hold, where that is a limit.
  connectionsPerInstance Int?          @map("connections_per_instance")
  // Added to a request passing through, when idle.
  latencyMs              Float         @map("latency_ms")
  monthlyCostPerInstance Float         @map("monthly_cost_per_instance")
  // Availability of one instance, as a fraction (0.999 = 99.9%).
  availability           Float
  // Share of reads answered without going further (caches and CDNs).
  hitRate                Float?        @map("hit_rate")
  // Short points for comparing technologies (shown when swapping, and given to the AI).
  strengths              String[]
  tradeoffs              String[]
  componentType          ComponentType @relation(fields: [componentTypeId], references: [id], onDelete: Cascade)
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")

  @@index([componentTypeId])
  @@map("component_implementations")
}
